{
    "uninstaller": {
        "windows": {
            "source_file": "pack/uninstall-windows-x86.exe",
            "installed_executable": "uninstall-windows-x86.exe"
        },
        "linux": {
            "source_file": "pack/uninstall-linux-x86.bin",
            "installed_executable": "uninstall-linux-x86.bin"
        },
        "darwin": {
            "source_file": "pack/uninstall-macos.zip",
            "installed_executable": "uninstall-macos.app/Contents/MacOS/uninstaller"
        }
    },
    "components": [
        {
            "display_name": "Shared runtime",
            "component_id": "runtime",
            "version": "5.0.0",
            "required": true,
            "selected_by_default": true,
            "description": "<b>Shared runtime</b>: files used by the core and add-ons.",
            "parent_component": null,
            "dependencies": [],
            "common_files": null,
            "windows_x86_files": [
                "pack/runtime-windows-x86.zip"
            ],
            "windows_x64_files": [
                "pack/runtime-windows-x64.zip"
            ],
            "linux_x86_files": [
                "pack/runtime-linux-x86.zip"
            ],
            "linux_x64_files": [
                "pack/runtime-linux-x64.zip"
            ],
            "macos_files": [
                "pack/runtime-macos.zip"
            ],
            "destinations": {
                "pack/runtime-windows-x86.zip": "{install_path}",
                "pack/runtime-windows-x64.zip": "{install_path}",
                "pack/runtime-linux-x86.zip": "{install_path}",
                "pack/runtime-linux-x64.zip": "{install_path}",
                "pack/runtime-macos.zip": "{install_path}"
            }
        },
        {
            "display_name": "Application core",
            "component_id": "core",
            "is_core_component": true,
            "version": "2.1.0",
            "required": true,
            "selected_by_default": true,
            "description": "<b>Application core</b>: the main removable component.",
            "default_install_path": "C:\\Program Files\\ExampleApplication",
            "default_linux_install_path": "/opt/example-application",
            "default_macos_install_path": "/Applications/ExampleApplication",
            "parent_component": null,
            "dependencies": [
                "runtime"
            ],
            "common_files": [
                "pack/application-core.zip",
                "pack/readme.txt"
            ],
            "windows_x86_files": [
                "pack/uninstall-windows-x86.exe"
            ],
            "windows_x64_files": [
                "pack/uninstall-windows-x86.exe"
            ],
            "linux_x86_files": [
                "pack/uninstall-linux-x86.bin"
            ],
            "linux_x64_files": [
                "pack/uninstall-linux-x86.bin"
            ],
            "macos_files": [
                "pack/uninstall-macos.zip"
            ],
            "remove_directories_on_uninstall": [
                "{install_path}/plugins/application-core"
            ],
            "destinations": {
                "pack/application-core.zip": "{install_path}",
                "pack/readme.txt": "{install_path}",
                "pack/uninstall-windows-x86.exe": "{install_path}",
                "pack/uninstall-linux-x86.bin": "{install_path}",
                "pack/uninstall-macos.zip": "{install_path}"
            }
        },
        {
            "display_name": "Optional add-ons",
            "component_id": "addons",
            "required": false,
            "selected_by_default": false,
            "partially_selected_by_default": true,
            "description": "Grouping-only entry; components without files may omit version.",
            "parent_component": null,
            "dependencies": [],
            "common_files": null,
            "destinations": null
        },
        {
            "display_name": "Example add-on",
            "component_id": "example_addon",
            "version": "1.2.3",
            "required": false,
            "selected_by_default": false,
            "description": "<b>Example add-on</b>: demonstrates dependencies and nesting.",
            "parent_component": "addons",
            "dependencies": [
                "runtime",
                "core"
            ],
            "common_files": [
                "pack/example-addon.zip"
            ],
            "destinations": {
                "pack/example-addon.zip": "{install_path}/plugins"
            }
        }
    ]
}
